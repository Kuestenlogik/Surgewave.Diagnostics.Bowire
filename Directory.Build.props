<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1572;CS1573;CS1574</NoWarn>
  </PropertyGroup>

  <!-- This repository versions itself. It is released after both products it
       sits between, so it can always build against the current Bowire and the
       current Surgewave without either of them waiting for it. That is the
       whole point of it being a separate repository. -->
  <PropertyGroup>
    <Version>0.1.0-dev</Version>
    <Authors>Kuestenlogik</Authors>
    <Company>Kuestenlogik</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Kuestenlogik/Surgewave.Diagnostics.Bowire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Plugin packaging via the Kuestenlogik.Surgewave.Build MSBuild tasks. The
       manifest lives next to the csproj because that is where the task looks
       ($(MSBuildProjectDirectory)\plugin.json); a copy at the repository root is
       read by nothing. Trigger:

         dotnet publish src/<plugin> -c Release -p:SurgewavePackPlugin=true

       The task packs whatever publish produced, so RemoveHostProvidedAssemblies
       and the CI content check keep doing their job unchanged. It also validates
       the manifest against PluginManifest and writes the sha256 sidecar, which a
       hand-written zip step in CI would not.

       $(SurgewavePluginVersion) defaults to $(Version) in newer versions of the
       Build package; until one is published the package takes the manifest's own
       version field. Nothing to do here when that lands - the property is already
       wired on their side. -->
  <PropertyGroup>
    <_SurgewavePluginManifestPath>$(MSBuildProjectDirectory)\plugin.json</_SurgewavePluginManifestPath>
    <SurgewaveSppOutputDir Condition="'$(SurgewaveSppOutputDir)' == ''">$(MSBuildThisFileDirectory)artifacts\pluginPackage\</SurgewaveSppOutputDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_SurgewavePluginManifestPath)')">
    <PackageReference Include="Kuestenlogik.Surgewave.Build" PrivateAssets="all" />
    <Content Update="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
