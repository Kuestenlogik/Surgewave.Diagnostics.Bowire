<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Everything this plugin needs is on nuget.org: the Bowire workbench, the
         surgewave:// adapter and the Surgewave plugin/client contracts. The org
         GitHub Packages source is deliberately not listed - it 401s in CI without
         org package read rights, and it only carries 0.1.0-ci.* prereleases. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
